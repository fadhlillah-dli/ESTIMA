# Konvensi format yang dibaca otomatis oleh VS Code dan editor lain (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = space
indent_size = 4

[*.{py,ps1}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{json,md}]
indent_style = space
indent_size = 4

[*.{yml,sh}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
